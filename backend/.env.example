NODE_ENV=development
PORT=3000
APP_NAME=Eco Fit API
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8088
SWAGGER_ENABLED=true

# Runtime: dùng pooled URL khi nhà cung cấp PostgreSQL hỗ trợ connection pooler.
DATABASE_URL=postgresql://ecofit:ecofit_dev_password@127.0.0.1:5433/ecofit?schema=public

# Migration/Studio: dùng kết nối trực tiếp, không đi qua transaction pooler.
DIRECT_URL=postgresql://ecofit:ecofit_dev_password@127.0.0.1:5433/ecofit?schema=public

DATABASE_CONNECT_ON_START=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
