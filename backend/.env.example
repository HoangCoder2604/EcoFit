NODE_ENV=development
PORT=3000
APP_NAME=Eco Fit API
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
SWAGGER_ENABLED=true

# Runtime: dùng pooled URL khi nhà cung cấp PostgreSQL hỗ trợ connection pooler.
DATABASE_URL=postgresql://ecofit:ecofit_dev_password@127.0.0.1:5433/ecofit?schema=public

# Migration/Studio: dùng kết nối trực tiếp, không đi qua transaction pooler.
DIRECT_URL=postgresql://ecofit:ecofit_dev_password@127.0.0.1:5433/ecofit?schema=public

DATABASE_CONNECT_ON_START=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Bắt buộc thay bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự khi deploy production.
JWT_ACCESS_SECRET=eco-fit-local-access-secret-change-before-production
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=eco-fit-api
JWT_AUDIENCE=eco-fit-app
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_BCRYPT_ROUNDS=12

# Local: mã xác minh được ghi log và trả về response để test.
# Production: đổi thành smtp và cấu hình nhà cung cấp email thật.
EMAIL_DELIVERY_MODE=console
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_FROM=no-reply@ecofit.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Danh sách OAuth Client ID (Web, Android/iOS nếu cần), phân cách bằng dấu phẩy.
GOOGLE_CLIENT_IDS=
